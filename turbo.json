{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": ["NEXT_PUBLIC_*", "API_URL"]
    },
    "typecheck": { "dependsOn": ["^typecheck"], "outputs": [] },
    "test": { "outputs": [] },
    "dev": { "cache": false, "persistent": true }
  }
}
