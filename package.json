{
  "name": "eleicoes-brasil",
  "version": "1.0.0",
  "private": true,
  "description": "Acompanhamento em tempo real da totaliza\u00e7\u00e3o das elei\u00e7\u00f5es brasileiras com dados p\u00fablicos oficiais do TSE.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:demo": "node scripts/dev-demo.mjs",
    "build": "turbo run build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @eleicoes/web test:e2e",
    "db:generate": "pnpm --filter @eleicoes/database db:generate",
    "db:migrate": "pnpm --filter @eleicoes/database db:migrate",
    "replay": "pnpm --filter @eleicoes/worker replay",
    "worker": "pnpm --filter @eleicoes/worker start"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "^24.19.0",
    "tsx": "^4.23.15",
    "turbo": "^2.11.5",
    "typescript": "~5.9.3",
    "vitest": "^5.0.2"
  }
}
