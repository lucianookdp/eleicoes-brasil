# ---------- shared ----------
DATABASE_URL=postgres://eleicoes:eleicoes@localhost:5432/eleicoes
LOG_LEVEL=info

# ---------- worker (collector) ----------
# DEVELOPMENT = local fictitious TSE (pnpm dev:demo) · SIMULATION = official TSE test runs
# PRODUCTION = official results · REPLAY = re-emit a recorded round
APP_MODE=DEVELOPMENT
# Round to follow, from packages/election-core/src/registry.ts: demo-1, 2026-1, 2026-2
ELECTION_ROUND=demo-1
# Optional: overrides the base URL of the selected mode (proxy, local demo server)
# TSE_BASE_URL=http://localhost:4010
# The TSE allows 100 requests/s per IP and blocks for 10 min above it. Stay well below.
TSE_REQUESTS_PER_SECOND=20
TSE_CONCURRENCY=8
# Seconds between headline cycles (Brazil + states); municipal files drain continuously
TSE_POLL_INTERVAL=5
TSE_TIMEOUT_MS=10000
TSE_MAX_RETRIES=3
COLLECT_CITY_RESULTS=true
# all | majoritarian (city-level deputy files are the heaviest)
CITY_RESULT_OFFICES=all
MAX_RESULT_FETCHES_PER_CYCLE=400
REPLAY_SPEED=10
DEMO_TSE_PORT=4010
DEMO_DURATION_MINUTES=30

# ---------- api ----------
PORT=4000
CORS_ORIGINS=http://localhost:3000
API_RATE_LIMIT_PER_MINUTE=6000
CACHE_TTL_SECONDS=10
ENABLE_SECTIONS_VIEW=false
ENABLE_REPLAY=true
ENABLE_ADVANCED_OPERATIONS=true
ENABLE_COMPARISON=true

# ---------- web ----------
# Public URL of the API as seen by browsers (inlined at build time)
NEXT_PUBLIC_API_URL=http://localhost:4000
# Path prefix when served from a sub-path (GitHub Pages project site), e.g. /eleicoes-brasil
NEXT_PUBLIC_BASE_PATH=
